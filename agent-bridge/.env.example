# 复制这个文件为 .env，然后改成你自己的值

# 端口，随便定，别跟别的服务冲突
PORT=8787

# 认证令牌 —— 随便生成一串长随机字符串，例如在终端跑：
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# 这个值也要填到手机App里，两边对不上就连不上，别用简单的密码
AUTH_TOKEN=

# Claude Code / Codex 实际操作的目录 —— 强烈建议单独建一个文件夹，
# 不要指向你的整个用户目录或者硬盘根目录
AGENT_WORKDIR=/Users/yourname/agent-workspace

# 单次任务最多允许几轮工具调用，避免失控刷太多次
MAX_TURNS=15
